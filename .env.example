PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/umanager

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional: enables AI dashboard personalization, order parsing, and the AI
# business assistant chat. Get a free key from console.groq.com. Leave blank to disable.
GROQ_API_KEY=

# Optional: enables product image upload. Get this from your Cloudinary dashboard. Leave blank to disable.
CLOUDINARY_URL=

# Sends mobile-number login OTPs via textbelt.com. Required in production for phone
# sign-in; when blank in development, codes are printed to the server console instead.
TEXTBELT_API_KEY=

# Social sign-in (optional). Google: OAuth 2.0 Web client ID. Apple: Sign in with Apple Services ID.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
